# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode — user-specific state (the project itself is generated by XcodeGen
# from project.yml; user data inside it should not be tracked)
xcuserdata/
*.xcuserstate
*.xcuserdatad
*.xcscmblueprint
*.xccheckout

# Build output
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# Local tooling config (Claude Code, editor state)
.claude/
.vscode/
.idea/

# Local sample media (don't commit test videos)
*.mp4
*.mov
*.m4v

# Release artifacts (produced by scripts/build-release.sh)
dist/
*.zip

# Local credentials and Apple signing material
.env
.env.*
!.env.example
*.p8
*.p12
*.pem
*.key
*.cer
*.mobileprovision
*.provisionprofile

# Xcode archives, diagnostics and local media drafts
*.xcarchive/
*.xcresult/
*.log
/Reel-draft.json
/Media/
*.wav
*.m4a
*.mp3
*.aiff
*.caf
